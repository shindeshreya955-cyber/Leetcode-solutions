class Solution:
    def stoneGameII(self, piles):
        n = len(piles)

        # Suffix sum
        suffix = [0] * (n + 1)
        for i in range(n - 1, -1, -1):
            suffix[i] = piles[i] + suffix[i + 1]

        dp = {}

        def solve(i, m):
            if i >= n:
                return 0

            if (i, m) in dp:
                return dp[(i, m)]

            best = 0

            for x in range(1, 2 * m + 1):
                if i + x > n:
                    break

                # Current player takes these stones
                # and opponent gets the best possible remaining score
                best = max(
                    best,
                    suffix[i] - solve(i + x, max(m, x))
                )

            dp[(i, m)] = best
            return best

        return solve(0, 1)
